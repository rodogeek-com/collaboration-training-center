---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ui } from '../../../data/ui';
export async function getStaticPaths(){const guides=await getCollection('guides');return guides.map(g=>({params:{lang:g.data.lang,id:g.data.guideId},props:{guide:g}}))}
const {guide}=Astro.props; const lang=guide.data.lang as 'en'|'es'; const t=ui[lang]; const {Content}=await render(guide); const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout lang={lang} title={`${guide.data.title} | ${t.portal}`} description={guide.data.description}><article class="guide"><a class="back" href={`${base}/${lang}/`}>← {t.back}</a><p class="category">{guide.data.category}</p><h1>{guide.data.title}</h1><p class="lead">{guide.data.description}</p><div class="facts"><div class="fact"><small>{t.time}</small><strong>{guide.data.minutes} min</strong></div><div class="fact"><small>{t.platforms}</small><strong>{guide.data.platforms.join(', ')}</strong></div><div class="fact"><small>{t.verified}</small><strong>{guide.data.lastVerified.toISOString().slice(0,10)}</strong></div></div><section class="outcome"><h2>{t.outcome}</h2><p>{guide.data.outcome}</p></section><section><h2>{t.requirements}</h2><p>{guide.data.requirements}</p></section><section><h2>{t.steps}</h2><Content /></section><section class="trouble"><h2>{t.trouble}</h2><p>{guide.data.trouble}</p></section><div class="actions"><button class="btn primary" onclick="window.print()">{t.print}</button><button class="btn" id="export-image">{t.image}</button><button class="btn">{t.report}</button></div><footer class="attribution">Created by <strong>Rodogeek</strong> · Attribution included in exported PDF and image</footer></article>
<script is:inline>document.querySelector('#export-image')?.addEventListener('click',()=>alert('PNG export with Rodogeek attribution is reserved for the next implementation phase.'))</script></BaseLayout>
