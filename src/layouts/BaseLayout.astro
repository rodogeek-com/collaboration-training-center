---
import '../styles/global.css';
import { Menu, Search, Languages } from 'lucide-astro';
import Sidebar from '../components/Sidebar.astro';
import { ui } from '../data/ui';

interface Props {
  lang?: 'en' | 'es';
  title: string;
  description?: string;
}

const { lang = 'en', title, description = '' } = Astro.props as Props;
const t = ui[lang];
const other: 'en' | 'es' = lang === 'en' ? 'es' : 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Preserve the current page when switching languages.
// Examples:
// /collaboration-training-center/en/ -> /collaboration-training-center/es/
// /collaboration-training-center/en/guides/transfer-call/ ->
// /collaboration-training-center/es/guides/transfer-call/
const currentPath = Astro.url.pathname;
const languagePath = currentPath.replace(
  new RegExp(`/${lang}(?=/|$)`),
  `/${other}`
);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <button
        id="menu-toggle"
        class="icon-button"
        type="button"
        aria-label={lang === 'en' ? 'Toggle navigation menu' : 'Mostrar u ocultar menú'}
        aria-controls="sidebar"
        aria-expanded="true"
      >
        <Menu size={21} aria-hidden="true" />
      </button>

      <div class="brand">
        <strong>{t.portal}</strong>
        <span>{t.subtitle}</span>
      </div>

      <div class="search top-search">
        <Search size={17} aria-hidden="true" />
        <input id="global-search" placeholder={t.search} aria-label={t.search} />
      </div>

      <a
        id="language-switch"
        class="language"
        href={languagePath}
        aria-label={lang === 'en' ? 'Cambiar a español' : 'Switch to English'}
        hreflang={other}
      >
        <Languages size={17} aria-hidden="true" />
        {other.toUpperCase()}
      </a>
    </header>

    <div id="page-layout" class="layout">
      <Sidebar lang={lang} base={base} />
      <main class="content">
        <slot />
        <footer class="global-attribution">
          Created by <strong>Rodogeek</strong> · Attribution included in exported PDF and image
        </footer>
      </main>
    </div>
  </div>

  <script is:inline define:vars={{ base }}>
    const menuButton = document.querySelector('#menu-toggle');
    const layout = document.querySelector('#page-layout');
    const sidebar = document.querySelector('#sidebar');
    const overlay = document.querySelector('#sidebar-overlay');
    const mobile = () => window.matchMedia('(max-width: 900px)').matches;

    function setSidebar(open) {
      if (mobile()) {
        sidebar?.classList.toggle('mobile-open', open);
        overlay?.classList.toggle('visible', open);
        document.body.classList.toggle('menu-open', open);
      } else {
        layout?.classList.toggle('sidebar-collapsed', !open);
        localStorage.setItem('ctc-sidebar-open', String(open));
      }
      menuButton?.setAttribute('aria-expanded', String(open));
    }

    setSidebar(mobile() ? false : localStorage.getItem('ctc-sidebar-open') !== 'false');

    menuButton?.addEventListener('click', () => {
      setSidebar(menuButton.getAttribute('aria-expanded') !== 'true');
    });

    overlay?.addEventListener('click', () => setSidebar(false));
    sidebar?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        if (mobile()) setSidebar(false);
      });
    });

    document.querySelector('#global-search')?.addEventListener('keydown', event => {
      if (event.key === 'Enter') {
        const value = event.target instanceof HTMLInputElement ? event.target.value : '';
        location.href = `${base}/${document.documentElement.lang}/?q=${encodeURIComponent(value)}`;
      }
    });
  </script>
</body>
</html>
