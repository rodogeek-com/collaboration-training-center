---
import '../styles/global.css';
import '../styles/global-search.css';
import { Menu, Search, Languages } from 'lucide-astro';
import Sidebar from '../components/Sidebar.astro';
import { ui } from '../data/ui';
interface Props { lang?: 'en'|'es'; title:string; description?:string; }
const {lang='en',title,description=''}=Astro.props as Props;
const t=ui[lang];
const other:'en'|'es'=lang==='en'?'es':'en';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const currentPath=Astro.url.pathname;
const languagePath=currentPath.replace(new RegExp(`/${lang}(?=/|$)`),`/${other}`);
const searchText=lang==='en'?{loading:'Loading search...',empty:'No guides found.',error:'Search is temporarily unavailable.'}:{loading:'Cargando búsqueda...',empty:'No se encontraron guías.',error:'La búsqueda no está disponible temporalmente.'};
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title></head><body>
<div class="shell"><header class="topbar"><button id="menu-toggle" class="icon-button" type="button" aria-label={lang==='en'?'Toggle navigation menu':'Mostrar u ocultar menú'} aria-controls="sidebar" aria-expanded="true"><Menu size={21}/></button><div class="brand"><strong>{t.portal}</strong><span>{t.subtitle}</span></div>
<div class="search top-search global-search-wrap"><Search size={17}/><input id="global-search" placeholder={t.search} aria-label={t.search} autocomplete="off"/><div id="search-results" class="search-results" hidden aria-live="polite"></div></div>
<a id="language-switch" class="language" href={languagePath} hreflang={other} aria-label={lang==='en'?'Cambiar a español':'Switch to English'}><Languages size={17}/>{other.toUpperCase()}</a></header>
<div id="page-layout" class="layout"><Sidebar lang={lang} base={base}/><main class="content"><slot/><footer class="global-attribution">Created by <strong>Rodogeek</strong> · Attribution included in exported PDF and image</footer></main></div></div>
<script is:inline define:vars={{base,lang,searchText}}>
const b=document.querySelector('#menu-toggle'),l=document.querySelector('#page-layout'),s=document.querySelector('#sidebar'),o=document.querySelector('#sidebar-overlay');const mobile=()=>matchMedia('(max-width:900px)').matches;function setOpen(open){if(mobile()){s?.classList.toggle('mobile-open',open);o?.classList.toggle('visible',open);document.body.classList.toggle('menu-open',open)}else{l?.classList.toggle('sidebar-collapsed',!open);localStorage.setItem('ctc-sidebar-open',String(open))}b?.setAttribute('aria-expanded',String(open))}setOpen(mobile()?false:localStorage.getItem('ctc-sidebar-open')!=='false');b?.addEventListener('click',()=>setOpen(b.getAttribute('aria-expanded')!=='true'));o?.addEventListener('click',()=>setOpen(false));s?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{if(mobile())setOpen(false)}));
const input=document.querySelector('#global-search'),box=document.querySelector('#search-results');let pagefind=null,timer=null;
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
async function loadSearch(){if(pagefind)return pagefind;pagefind=await import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`);await pagefind.init();return pagefind}
async function runSearch(q){if(!box)return;if(q.trim().length<2){box.hidden=true;box.innerHTML='';return}box.hidden=false;box.innerHTML=`<div class="search-state">${esc(searchText.loading)}</div>`;try{const pf=await loadSearch();const response=await pf.search(q,{filters:{lang}});const items=await Promise.all(response.results.slice(0,8).map(r=>r.data()));if(!items.length){box.innerHTML=`<div class="search-state">${esc(searchText.empty)}</div>`;return}box.innerHTML=items.map(item=>`<a class="search-result" href="${esc(item.url)}"><strong>${esc(item.meta.title)}</strong><span>${esc(item.meta.description||'')}</span></a>`).join('')}catch(e){console.error(e);box.innerHTML=`<div class="search-state">${esc(searchText.error)}</div>`}}
input?.addEventListener('input',e=>{clearTimeout(timer);timer=setTimeout(()=>runSearch(e.target.value),180)});input?.addEventListener('keydown',e=>{if(e.key==='Escape'){box.hidden=true;input.blur()}});document.addEventListener('click',e=>{if(!e.target.closest('.global-search-wrap'))box.hidden=true});
</script></body></html>
