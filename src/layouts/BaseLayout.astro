---
import '../styles/global.css';
import { Menu, Search, Languages } from 'lucide-astro';
import Sidebar from '../components/Sidebar.astro';
import { ui } from '../data/ui';
interface Props { lang?:'en'|'es'; title:string; description?:string; }
const {lang='en',title,description=''}=Astro.props as Props;
const t=ui[lang]; const other:'en'|'es'=lang==='en'?'es':'en'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title></head><body>
<div class="shell"><header class="topbar"><button id="menu-toggle" class="icon-button" aria-label={lang==='en'?'Toggle navigation menu':'Mostrar u ocultar menú'} aria-controls="sidebar" aria-expanded="true"><Menu size={21}/></button><div class="brand"><strong>{t.portal}</strong><span>{t.subtitle}</span></div><div class="search top-search"><Search size={17}/><input id="global-search" placeholder={t.search}/></div><a class="language" href={`${base}/${other}/`}><Languages size={17}/>{other.toUpperCase()}</a></header><div id="page-layout" class="layout"><Sidebar lang={lang} base={base}/><main class="content"><slot/><footer class="global-attribution">Created by <strong>Rodogeek</strong> · Attribution included in exported PDF and image</footer></main></div></div>
<script is:inline define:vars={{base}}>
const b=document.querySelector('#menu-toggle'),l=document.querySelector('#page-layout'),s=document.querySelector('#sidebar'),o=document.querySelector('#sidebar-overlay');const mobile=()=>matchMedia('(max-width:900px)').matches;function setOpen(open){if(mobile()){s?.classList.toggle('mobile-open',open);o?.classList.toggle('visible',open);document.body.classList.toggle('menu-open',open)}else{l?.classList.toggle('sidebar-collapsed',!open);localStorage.setItem('ctc-sidebar-open',String(open))}b?.setAttribute('aria-expanded',String(open))}setOpen(mobile()?false:localStorage.getItem('ctc-sidebar-open')!=='false');b?.addEventListener('click',()=>setOpen(b.getAttribute('aria-expanded')!=='true'));o?.addEventListener('click',()=>setOpen(false));s?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{if(mobile())setOpen(false)}));document.querySelector('#global-search')?.addEventListener('keydown',e=>{if(e.key==='Enter')location.href=`${base}/${document.documentElement.lang}/?q=${encodeURIComponent(e.target.value)}`});
</script></body></html>
